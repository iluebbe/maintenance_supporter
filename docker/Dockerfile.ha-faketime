FROM alpine:3.21 AS faketime-builder
RUN apk add --no-cache build-base git
# Pinned to the master commit the dev image was built from (2026-05-03),
# proven over many simulated years. Master moved on: its time64 build (added
# 2026-08-31) fails with -Werror on musl. The release v0.9.12 (2025-06) builds
# but deadlocks Home Assistant now and then (0 % CPU, never answers HTTP).
ARG LIBFAKETIME_REF=2ba77bd61bd8101ab499c6a2202192d970d963bf
RUN git clone https://github.com/wolfcw/libfaketime.git /libfaketime \
    && cd /libfaketime && git checkout -q "$LIBFAKETIME_REF" \
    && cd src && make

FROM ghcr.io/home-assistant/home-assistant:2026.7.2
COPY --from=faketime-builder \
  /libfaketime/src/libfaketime.so.1 \
  /usr/local/lib/faketime/libfaketime.so.1

# Replace the HA run script with our version that adds faketime to LD_PRELOAD
# --chmod: a Linux checkout keeps the file's 0644, and s6 cannot spawn a run
# script that is not executable (a Windows build context hides this).
COPY --chmod=755 ha-run-faketime.sh /etc/services.d/home-assistant/run
