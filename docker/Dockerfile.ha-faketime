FROM alpine:3.21 AS faketime-builder
RUN apk add --no-cache build-base git
# Pinned: master moves under us, and musl >= 1.2.4 only declares the *64
# stat structs with _LARGEFILE64_SOURCE (without it the -Werror build fails);
# v0.9.13 adds a time64 build that fails on musl either way.
ARG LIBFAKETIME_REF=v0.9.12
RUN git clone --depth 1 --branch "$LIBFAKETIME_REF" https://github.com/wolfcw/libfaketime.git /libfaketime \
    && cd /libfaketime/src && make FAKETIME_COMPILE_CFLAGS="-D_LARGEFILE64_SOURCE"

FROM ghcr.io/home-assistant/home-assistant:2026.7.2
COPY --from=faketime-builder \
  /libfaketime/src/libfaketime.so.1 \
  /usr/local/lib/faketime/libfaketime.so.1

# Replace the HA run script with our version that adds faketime to LD_PRELOAD
COPY ha-run-faketime.sh /etc/services.d/home-assistant/run
